generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id              String    @id @default(cuid())
  title           String
  titleEn         String?
  description     String    @db.Text
  descriptionEn   String?   @db.Text
  price           Float
  category        Category  @relation(fields: [categoryId], references: [id])
  categoryId      String
  images          String[]
  slug            String    @unique
  featured        Boolean   @default(false)
  active          Boolean   @default(true)
  seoTitle        String?
  seoDescription  String?
  colors          String[]
  sizes           String[]
  careInstructions String?  @db.Text
  occasions       String[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  orders          Order[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  nameEn      String?
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Order {
  id                 String      @id @default(cuid())
  customerName       String
  email              String
  phone              String
  product            Product     @relation(fields: [productId], references: [id])
  productId          String
  deliveryDate       DateTime?
  deliveryAddress    String?
  specialInstructions String?    @db.Text
  status             OrderStatus @default(PENDING)
  notes              String?     @db.Text
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  content      String   @db.Text
  rating       Int      @default(5)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Settings {
  id               String   @id @default(cuid())
  businessName     String   @default("Olivia's Flowers")
  tagline          String   @default("Çdo Kompozim Tregon një Histori")
  description      String?  @db.Text
  email            String?
  phone            String?
  whatsappNumber   String?
  address          String?
  businessHours    Json?
  socialLinks      Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum UserRole {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONTACTED
  CONFIRMED
  DELIVERED
  CANCELLED
}